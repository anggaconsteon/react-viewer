{
  "_meta": {
    "uxPattern": "A - Peek expand. Single page, 1 collapse level. Expanded site card shows top-N priority workers inline + 'Lihat semua (N)' tail CTA -> drill to CheckinSiteDetail for full list.",
    "designSource": "consteon-worker-app.html#s-routes-grouped (Smart-group shell) + consteon-supervisor-app.html#s-attendance (data shape)",
    "pages": [
      "CheckinPerSite (main)",
      "CheckinSiteDetail (Lihat semua drill)"
    ],
    "tables": {
      "vtl.area-stats": "Aggregated per-area attendance snapshot. One row per area per shift.",
      "vtl.checkin-active": "Live worker check-in records. One row per worker. Filtered by area_id on detail. Includes priorityRank column for peek sort."
    },
    "widgetTabExtensionRequired": {
      "type": "displayList",
      "newVariant": "tableCardPeek",
      "newProps": {
        "peekTable": "child table joined by foreign key",
        "peekJoinOn": "<N> = <M>",
        "peekLimit": "int, top-N rows shown inline when expanded",
        "peekSort": "<N> asc|desc, sort key for priority ordering",
        "peekContent": "child-row text using ◆ delim",
        "peekRowImage": "<N> child column",
        "peekTrailingText": "<N> child column",
        "peekTailCta": "tail row text with <peekCount> token, e.g. 'Lihat semua (<peekCount>)'",
        "peekTailRoute": "route to drill page",
        "peekTailPassParams": "siteId=<N>"
      },
      "rationale": "Existing tableCardInteractive renders flat rows only. Peek variant needed to render N child rows + CTA inline inside parent card body."
    },
    "proxyMap_areaStats": {
      "1": "areaId",
      "2": "areaName",
      "3": "areaIcon (building-skyscraper / parking / store)",
      "4": "hadirCount",
      "5": "totalAssigned",
      "6": "pct",
      "7": "summaryLine ('12/12 hadir · 100%')",
      "8": "statusKey (success/warning/danger)",
      "9": "absentCount",
      "10": "areaSubMeta",
      "11": "trailingIcon (circle-check / alert-circle)"
    },
    "proxyMap_checkinActive": {
      "1": "recordId",
      "2": "checkinTs",
      "3": "workerName",
      "4": "workerInitial",
      "5": "areaId",
      "6": "areaName",
      "7": "currentActivity",
      "8": "statusKey",
      "9": "lastSeenLocation",
      "10": "priorityRank (1=absent, 2=paused/warning, 3=active, 4=standby) - drives peek sort",
      "11": "ctaLabel (Reassign / Hubungi / empty)",
      "12": "ctaRoute"
    },
    "peekPriorityOrder": "asc on <10> -> absent first, then paused, active, standby"
  },
  "CheckinPerSite": [
    {
      "type": "TXT",
      "variant": "kpiBanner",
